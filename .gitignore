# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
.playwright-vercel-chromium.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Accidental nested iMac repository copy (preserved on disk; see ROVEXO_BACKUP_*)
/ROVEXO/

# Staff native shell dependencies
/apps/rovexo-staff/node_modules/

# Local lint reports
/eslint-out.json
/eslint-report.json
/lint-report.txt

# Debug / regression run logs
/prod-fix.log
/prod-reg.log
/regression-report.log
/startup.log
/test.txt
.tmp-*
compare-preview.env
compare-production.env
test-preview.env
test-production.env

# Local ops helpers (never deploy secrets tooling via candidate by accident)
/scripts/sync-supabase-service-role-from-vercel.mjs

# Local archived work
_wip/

tmp/
.local-chromium-libs/
.local-chromium-deps/

# Local package manager cache — never part of release
.pnpm-store/

# Local design source dumps — runtime assets live under public/assets
/assets/
