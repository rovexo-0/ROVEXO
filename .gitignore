# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
.playwright-vercel-chromium.json
.playwright-webkit-launchable

# next.js
/.next/
/out/

# production
/build

# ROVEXO Backup Engine v1.0 artifacts (may contain DB dumps / env copies)
.rovexo-backups/
BACKUP_REPORT.md

# Production → local data mirror artifacts (PII / object copies; never commit)
.rovexo-local-mirror/

# Local Supabase CLI temp / start-secrets — never commit
supabase/.temp/
supabase/.branches/

# Nested worktrees — never part of web Production Deploy
.worktrees/

# Android local SDK user dirs / debug keystores
apps/rovexo-android/.android-user/
apps/rovexo-android/.android-user-as-home/

# Local preview / Lighthouse dumps
.cursor-preview-headers.txt
/lighthouse-hp-lcp-*.json
/lan-shipping-cert-probe.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Accidental nested iMac repository copy (preserved on disk; see ROVEXO_BACKUP_*)
/ROVEXO/

# Staff native shell dependencies
/apps/rovexo-staff/node_modules/

# Local lint reports
/eslint-out.json
/eslint-report.json
/lint-report.txt

# Debug / regression run logs
/prod-fix.log
/prod-reg.log
/regression-report.log
/startup.log
/test.txt
.tmp-*
compare-preview.env
compare-production.env
test-preview.env
test-production.env

# Local ops helpers (never deploy secrets tooling via candidate by accident)
/scripts/sync-supabase-service-role-from-vercel.mjs

# Local archived work
_wip/

tmp/
.local-chromium-libs/
.local-chromium-deps/
.local-webkit-libs/

# Local package manager cache — never part of release
.pnpm-store/

# Local design source dumps — runtime assets live under public/assets
/assets/
